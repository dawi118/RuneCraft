# Existing shared author key. Set in Netlify with Functions scope.
# For local preview/development, put this in an untracked .env file.
ADMIN_TOKEN=
# Optional: ADMIN_TOKEN also signs sessions when this is unset.
SESSION_SECRET=

# Production namespace only. Deploy previews use a deploy-specific namespace automatically.
CONTENT_NAMESPACE=gielinor-reforged-production
# Optional public-only GitHub backup (requires an existing backup branch).
PUBLIC_BACKUP_REPO=
PUBLIC_BACKUP_BRANCH=
PUBLIC_BACKUP_TOKEN=

# Local development only; do not enable in hosted production.
# REFORGED_LOCAL_STORE=1
# LOCAL_CONTENT_DIR=.local-content
