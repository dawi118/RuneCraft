{
  "name": "gielinor-reforged",
  "version": "1.0.0",
  "private": true,
  "description": "Gielinor: Reforged — a server-rendered build atlas, journal and author workspace.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/prepare.mjs && node scripts/dev.mjs",
    "build": "node scripts/prepare.mjs && astro build",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.5",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@netlify/blobs": "^10.0.0",
    "astro": "^7.3.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
